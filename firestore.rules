rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.nik is string && data.nik.size() <= 20
          && data.name is string && data.name.size() <= 100
          && data.keys().hasAll(['nik', 'name']);
    }

    function isValidAbsensi(data) {
      return data.userId is string && data.userId == request.auth.uid
          && data.date is string && data.date.size() == 10
          && data.masuk is string && data.masuk.size() <= 50
          && data.status in ['hadir', 'pulang', 'terlambat']
          && (data.pulang == null || data.pulang is string)
          && data.keys().hasAll(['userId', 'date', 'masuk', 'status', 'timestamp']);
    }

    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming())
                    && existsAfter(/databases/$(database)/documents/nik_lookup/$(incoming().nik));
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
    }

    match /nik_lookup/{nik} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/nik_lookup/$(nik))
                    && incoming().uid == request.auth.uid;
    }

    match /absensi/{absensiId} {
      // Use get/list explicitly
      allow get: if isSignedIn() && (absensiId.startsWith(request.auth.uid) || (resource != null && resource.data.userId == request.auth.uid));
      allow list: if isSignedIn() && request.query.limit <= 100 && (resource == null || resource.data.userId == request.auth.uid);
      
      allow create: if isSignedIn() 
                    && (incoming().userId == request.auth.uid || absensiId.startsWith(request.auth.uid))
                    && isValidAbsensi(incoming());
      
      allow update: if isSignedIn()
                    && (resource.data.userId == request.auth.uid || absensiId.startsWith(request.auth.uid))
                    && (
                      incoming().diff(existing()).affectedKeys().hasOnly(['pulang', 'status'])
                      && (incoming().status == 'pulang')
                    );
    }
  }
}

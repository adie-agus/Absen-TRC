rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.1 Context-Aware Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 1. Validation Blueprints
    function isValidUser(data) {
      return data.nik is string && data.nik.size() <= 20
          && data.name is string && data.name.size() <= 100
          && data.keys().hasAll(['nik', 'name'])
          && data.keys().size() <= 10; // Flexible for future fields
    }

    function isValidAbsensi(data) {
      return data.userId is string && data.userId == request.auth.uid
          && data.date is string && data.date.size() == 10
          && data.masuk is string && data.masuk.size() <= 50
          && data.status in ['hadir', 'pulang', 'terlambat']
          && (data.pulang == null || data.pulang is string)
          && data.keys().hasAll(['userId', 'date', 'masuk', 'status', 'timestamp']);
    }

    // 2. Resource Match Blocks
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
                    && incoming().nik == existing().nik; // NIK Immutable
    }

    match /absensi/{absensiId} {
      // 8. Secure List Queries (No blanket reads)
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
                    && isValidAbsensi(incoming())
                    && incoming().timestamp == request.time;
      
      allow update: if isSignedIn()
                    && isOwner(existing().userId)
                    && isValidId(absensiId)
                    && (
                      // Action: Pulang (Clock Out)
                      incoming().diff(existing()).affectedKeys().hasOnly(['pulang', 'status'])
                      && incoming().status == 'pulang'
                      && existing().pulang == null
                      && incoming().pulang is string
                    );
      
      allow delete: if false; // Absensi cannot be deleted by users
    }
  }
}
